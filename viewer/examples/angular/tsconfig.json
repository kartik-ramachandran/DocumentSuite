{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "outDir": "dist/out-tsc",
    "paths": {
      "@document-suite/angular": ["../../packages/angular/dist"]
    }
  },
  "angularCompilerOptions": { "strictTemplates": true },
  "files": ["src/main.ts"]
}
