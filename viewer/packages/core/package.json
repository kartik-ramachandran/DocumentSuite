{
  "name": "@document-suite/viewer",
  "version": "0.2.0",
  "description": "A framework-independent PDF viewer for the browser, with optional server rendering.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "viewerjs": "1.15.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kartik-ramachandran/DocumentSuite.git",
    "directory": "viewer/packages/core"
  },
  "homepage": "https://github.com/kartik-ramachandran/DocumentSuite/tree/main/viewer#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pdf",
    "pdf-viewer",
    "image-viewer",
    "viewer",
    "pdfjs",
    "annotations",
    "document-viewer"
  ],
  "bugs": {
    "url": "https://github.com/kartik-ramachandran/DocumentSuite/issues"
  }
}
